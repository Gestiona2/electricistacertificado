---
import Layout from "../layouts/Layout.astro";
import datos from "../datos/inicio.json";
import sitio from "../datos/sitio.json";
import { ruta } from "../lib/ruta";

const {
  meta,
  portada,
  confianza,
  servicios,
  proceso,
  nosotros,
  trabajos,
  faq,
  contacto,
  pie,
} = datos;

const whatsappUrl = `https://wa.me/${sitio.whatsapp}?text=${encodeURIComponent(sitio.whatsappMensaje)}`;
---

<Layout titulo={meta.titulo} descripcion={meta.descripcion}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span aria-hidden="true"></span>{portada.encabezado}</p>
        <h1 id="hero-title">{portada.titulo}<span>{portada.tituloAcento}</span></h1>
        <p class="hero-description">{portada.texto}</p>
        <div class="hero-actions">
          <a class="btn btn-accent" href={ruta(portada.botones[0].href)} target="_blank" rel="noopener">{portada.botones[0].texto}</a>
          <a class="btn btn-ghost" href={ruta(portada.botones[1].href)}>{portada.botones[1].texto}</a>
        </div>
        <div class="hero-proof">
          <div class="proof-icon" aria-hidden="true">✓</div>
          <div>
            <strong>{portada.sello}</strong>
            <span>Instalaciones, reparaciones y mantenimiento</span>
          </div>
        </div>
      </div>

      <div class="hero-media">
        <div class="hero-frame">
          <img src={ruta(portada.imagen)} alt={portada.imagenAlt} fetchpriority="high" width="1200" height="1797" />
          <div class="hero-stamp"><span>JHON JAIRO</span><strong>ESPINOSA</strong><small>Electricista certificado</small></div>
        </div>
        <p class="image-credit">{portada.nota}</p>
      </div>
    </div>
  </section>

  <section class="confidence" aria-labelledby="confidence-title">
    <div class="container">
      <h2 id="confidence-title" class="sr-only">{confianza.titulo}</h2>
      <div class="confidence-grid">
        {confianza.items.map((item, index) => (
          <div class="confidence-item">
            <span class="confidence-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <div><h3>{item.titulo}</h3><p>{item.texto}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section services" id="servicios" aria-labelledby="services-title">
    <div class="container">
      <header class="section-heading">
        <p class="eyebrow"><span aria-hidden="true"></span>{servicios.encabezado}</p>
        <h2 id="services-title">{servicios.titulo}</h2>
        <p>{servicios.texto}</p>
      </header>
      <div class="services-grid">
        {servicios.items.map((item) => (
          <article class="service-card">
            <div class="service-image"><img src={ruta(item.imagen)} alt={item.titulo + " en Bogotá"} loading="lazy" width="720" height="540" /></div>
            <div class="service-body">
              <div class="service-title-row"><h3>{item.titulo}</h3><span class="service-icon" aria-hidden="true">{item.icono === "zap" ? "ϟ" : item.icono === "wrench" ? "⌁" : item.icono === "shield" ? "◈" : item.icono === "lightbulb" ? "✦" : item.icono === "plug" ? "⊕" : item.icono === "tv" ? "□" : "∿"}</span></div>
              <p>{item.texto}</p>
              <small>{item.detalle}</small>
              <a class="service-link" href={whatsappUrl} target="_blank" rel="noopener">Consultar este servicio <span aria-hidden="true">↗</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="process" id="proceso" aria-labelledby="process-title">
    <div class="container process-grid">
      <header class="process-heading">
        <p class="eyebrow eyebrow-light"><span aria-hidden="true"></span>{proceso.encabezado}</p>
        <h2 id="process-title">{proceso.titulo}</h2>
        <p>{proceso.texto}</p>
        <a class="btn btn-accent" href={whatsappUrl} target="_blank" rel="noopener">Escribir por WhatsApp</a>
      </header>
      <ol class="process-steps">
        {proceso.pasos.map((paso) => (
          <li><span>{paso.numero}</span><div><h3>{paso.titulo}</h3><p>{paso.texto}</p></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section about" id="nosotros" aria-labelledby="about-title">
    <div class="container about-grid">
      <div class="about-image">
        <img src={ruta(nosotros.imagen)} alt={nosotros.imagenAlt} loading="lazy" width="900" height="900" />
        <div class="about-badge"><span>◉</span>{nosotros.firma}</div>
      </div>
      <div class="about-copy">
        <p class="eyebrow"><span aria-hidden="true"></span>{nosotros.encabezado}</p>
        <h2 id="about-title">{nosotros.titulo}</h2>
        <p class="about-lead">{nosotros.texto}</p>
        <p>{nosotros.textoSecundario}</p>
        <a class="btn btn-primary" href={ruta(nosotros.boton.href)} target="_blank" rel="noopener">{nosotros.boton.texto}</a>
      </div>
    </div>
  </section>

  <section class="section work" id="trabajos" aria-labelledby="work-title">
    <div class="container">
      <header class="section-heading section-heading-split">
        <div>
          <p class="eyebrow"><span aria-hidden="true"></span>{trabajos.encabezado}</p>
          <h2 id="work-title">{trabajos.titulo}</h2>
        </div>
        <div><p>{trabajos.texto}</p><a class="text-link" href={ruta(trabajos.boton.href)} target="_blank" rel="noopener">{trabajos.boton.texto} <span aria-hidden="true">↗</span></a></div>
      </header>
      <div class="work-grid">
        {trabajos.items.map((item, index) => (
          <figure class={index === 0 ? "work-item work-item-wide" : "work-item"}>
            <img src={ruta(item.imagen)} alt={item.alt} loading="lazy" width="1200" height="900" />
            <figcaption>{item.titulo}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section faq" id="faq" aria-labelledby="faq-title">
    <div class="container faq-grid">
      <header>
        <p class="eyebrow"><span aria-hidden="true"></span>{faq.encabezado}</p>
        <h2 id="faq-title">{faq.titulo}</h2>
        <p class="faq-note">{faq._nota}</p>
      </header>
      <div class="faq-list">
        {faq.items.map((item) => (
          <details><summary>{item.pregunta}<span aria-hidden="true">+</span></summary><p>{item.respuesta}</p></details>
        ))}
      </div>
    </div>
  </section>

  <section class="contact" id="contacto" aria-labelledby="contact-title">
    <div class="container contact-inner">
      <div class="contact-mark" aria-hidden="true">ϟ</div>
      <div>
        <p class="eyebrow eyebrow-light"><span aria-hidden="true"></span>{contacto.encabezado}</p>
        <h2 id="contact-title">{contacto.titulo}</h2>
        <p>{contacto.texto}</p>
      </div>
      <div class="contact-actions">
        <a class="btn btn-accent" href={ruta(contacto.boton.href)} target="_blank" rel="noopener">{contacto.boton.texto}</a>
        <strong>{contacto.telefono}</strong>
        <span>{contacto.zona}</span>
      </div>
    </div>
  </section>
</Layout>
