---
import "../styles/global.css";
import "../styles/animaciones.css";
import "../styles/tarjeta.css";
import fuenteUrl from "../fonts/montserrat-variable.woff2?url";
import sitio from "../datos/sitio.json";
import { ruta } from "../lib/ruta";

interface Props {
  titulo: string;
  descripcion: string;
  imagen?: string;
}
const { titulo, descripcion, imagen } = Astro.props;
const ui = sitio.interfaz;
const claveTema = sitio.claveTema;
const imagenOg = imagen && Astro.site ? new URL(ruta(imagen), Astro.site).href : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#082b52" />
    <meta name="robots" content="noindex, follow" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="profile" />
    <meta property="og:locale" content="es_CO" />
    {imagenOg && <meta property="og:image" content={imagenOg} />}
    <link rel="icon" href={ruta("/brand/favicon.png")} type="image/png" />
    <link rel="preload" href={fuenteUrl} as="font" type="font/woff2" crossorigin />
    <!-- Tema: siempre claro. Solo pasa a oscuro si la persona lo activó con el botón. -->
    <script is:inline define:vars={{ claveTema }}>
      document.documentElement.classList.add("js");
      try {
        if (localStorage.getItem(claveTema) === "oscuro") document.documentElement.dataset.tema = "oscuro";
      } catch (e) {}
    </script>
  </head>
  <body class="pagina-tarjeta">
    <slot />

    <script>
      import "../scripts/movimiento.js";
    </script>

    <script is:inline define:vars={{ claveTema }}>
      (function () {
        var raiz = document.documentElement;
        var boton = document.getElementById("botonTema");
        if (!boton) return;
        function pintar() {
          var oscuro = raiz.dataset.tema === "oscuro";
          boton.setAttribute("aria-pressed", String(oscuro));
          boton.setAttribute("aria-label", oscuro ? boton.dataset.claro : boton.dataset.oscuro);
        }
        boton.addEventListener("click", function () {
          var oscuro = raiz.dataset.tema === "oscuro";
          if (oscuro) delete raiz.dataset.tema; else raiz.dataset.tema = "oscuro";
          try { localStorage.setItem(claveTema, oscuro ? "claro" : "oscuro"); } catch (e) {}
          pintar();
        });
        pintar();
      })();
    </script>
  </body>
</html>
